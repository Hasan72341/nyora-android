<?xml version="1.0" encoding="utf-8"?>
<!-- Popup and overflow menu background. Theme attributes keep it aligned with
     the Material palette in both light and dark without a -night variant. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
	android:shape="rectangle">
	<solid android:color="?attr/colorSurfaceContainer" />
	<corners android:radius="20dp" />
	<stroke
		android:width="1.2dp"
		android:color="?attr/colorOutlineVariant" />
</shape>
