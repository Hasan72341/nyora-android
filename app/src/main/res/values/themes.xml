	<!--== Default Theme ==-->
	<style name="Theme.Nyora" parent="Base.Theme.Nyora" />

	<!-- Base ThemeOverlay -->
	<style name="ThemeOverlay.Nyora" parent="ThemeOverlay.Material3.Light" />

	<!-- Monet theme only support S+ -->
	<style name="ThemeOverlay.Nyora.Monet" parent="ThemeOverlay.Material3.DynamicColors.DayNight" />

