		<item name="fastScrollerStyle">@style/Widget.Nyora.FastScroller</item>
		<item name="listItemTextViewStyle">@style/Widget.Nyora.ListItemTextView</item>
		<item name="dotIndicatorStyle">@style/Widget.Nyora.DotIndicator</item>
		<item name="badgeViewStyle">@style/Widget.Nyora.BadgeView</item>
		<item name="coverImageViewStyle">@style/Widget.Nyora.ImageView.Cover</item>
