<?xml version="1.0" encoding="utf-8"?>
<network-security-config
	xmlns:tools="http://schemas.android.com/tools">
	<!-- Need to allow cleartext traffic for some sources -->
	<base-config
		cleartextTrafficPermitted="true"
		tools:ignore="InsecureBaseConfiguration">
		<trust-anchors>
			<!-- Trust only preinstalled system CAs. User-added CAs are intentionally NOT trusted:
			     opting into them app-wide enables trivial MITM of all traffic (incl. auth flows). -->
			<certificates src="system" />
		</trust-anchors>
	</base-config>
</network-security-config>